// 2. Temperature Converter
Console.WriteLine("Temperature Converter Problem");

Console.WriteLine("Please input temperature in Celsius.");
double celsius = Convert.ToInt32(Console.ReadLine());

double fahrenheit = (celsius * 9 / 5) + 32;
double kelvin = celsius + 273.15;

Console.WriteLine();

Console.WriteLine(celsius + " (Celsius > 30)");
Console.WriteLine(celsius > 30);
Console.WriteLine();

Console.WriteLine(fahrenheit + " (Fahrenheit > 86)");
Console.WriteLine(fahrenheit > 86);
Console.WriteLine();

Console.WriteLine(kelvin + " (Kelvin > 300)");
Console.WriteLine(kelvin > 300);
Console.WriteLine();
